#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "$0")/.." && pwd)
scratch=$(mktemp -d)
trap 'rm -rf -- "$scratch"' EXIT
cc -std=c11 -Wall -Wextra -Werror -I"$root/source/sdl/src" \
  "$root/tests/wide_island_test.c" "$root/source/sdl/src/wide_island_layout.c" -lm -o "$scratch/wide-island"
"$scratch/wide-island"
