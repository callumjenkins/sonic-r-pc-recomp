# /// script
# requires-python = ">=3.11,<3.13"
# dependencies = ["numpy==2.3.4", "pillow==12.0.0", "spandrel==0.4.2", "torch==2.9.1"]
#
# [[tool.uv.index]]
# name = "pytorch-cu128"
# url = "https://download.pytorch.org/whl/cu128"
# explicit = true
#
# [tool.uv.sources]
# torch = { index = "pytorch-cu128" }
