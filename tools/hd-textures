#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["numpy==2.3.4", "pillow==12.0.0"]
# ///
"""Dump stock texture pages to PNG, and turn PNG replacement pages into an HD pack the engine loads."""
import argparse
from collections.abc import Iterator
from pathlib import Path

import numpy as np
from PIL import Image

PAGE = 256
PAGE_BYTES = PAGE * PAGE * 3
PLY_COLUMNS, PLY_ROWS, TILE = 10, 12, 32
ROOT = Path(__file__).resolve().parent.parent
SIDES = (512, 1024, 2048)


def is_key(rgb: np.ndarray) -> np.ndarray:
    """The engine keys a texel when its 5-bit colour is R0 G31 B0."""
    return (rgb[..., 0] < 8) & (rgb[..., 1] >= 248) & (rgb[..., 2] < 8)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--data", type=Path, default=ROOT / "gamedata", help="Stock game data folder")
    commands = parser.add_subparsers(required=True)
    command = commands.add_parser("dump", help="Write every stock page as PNG, with the key green as transparency")
    command.add_argument("--out", type=Path, default=ROOT / "playtests/hd/stock")
    command.set_defaults(run=_dump)
    command = commands.add_parser("resize", help="Write stock pages scaled up by repeating texels, for testing the engine")
    command.add_argument("--scale", type=int, choices=[2, 4, 8], default=4)
    command.add_argument("--invert", action="store_true", help="Invert the colours, so a test can tell the pack was used")
    command.add_argument("--only", action="append", help="Name prefix to include, such as ISLAND/ or GENERAL/PLAYER")
    command.add_argument("--out", type=Path, required=True)
    command.set_defaults(run=_resize)
    command = commands.add_parser("pack", help="Turn a folder of PNG pages into a pack the engine reads")
    command.add_argument("source", type=Path)
    command.add_argument("name", type=pack_name, help="The pack's folder inside the game data's HD folder")
    command.add_argument("--out", type=Path, help="Where to write the pack instead")
    command.set_defaults(run=_pack)
    args = parser.parse_args()
    args.run(args)


def pack_name(text: str) -> str:
    """The engine's rule for a pack name: one folder inside HD, not hidden, printable, and under 64 bytes."""
    printable = all(32 <= ord(c) != 127 for c in text)
    if not text or text.startswith(".") or "/" in text or "\\" in text or not printable or len(text.encode()) >= 64:
        raise argparse.ArgumentTypeError(f"{text!r} cannot name a pack")
    return text


def pack_page(image: np.ndarray, stock: np.ndarray) -> np.ndarray:
    """Fits a replacement page to the stock page's key mask and returns the RGBA texels the engine reads."""
    side = image.shape[0]
    if image.shape[:2] != (side, side) or side not in SIDES:
        raise ValueError(f"must be a square of {', '.join(map(str, SIDES))} pixels, not {image.shape[1]}x{image.shape[0]}")
    scale = side // PAGE
    mask = ~is_key(stock)
    page = np.dstack([image[..., :3], np.where(mask.repeat(scale, 0).repeat(scale, 1), 255, 0).astype(np.uint8)])
    return fill_transparent(page)


def playfield_pages(raw: bytes) -> list[np.ndarray]:
    """Lays the PLY tiles out on two pages the way D3D_LoadPlayfieldTilesRGB does."""
    sheet = np.frombuffer(raw, np.uint8).reshape(PLY_ROWS * TILE, PLY_COLUMNS * TILE, 3)
    pages = [np.zeros((PAGE, PAGE, 3), np.uint8) for _ in range(2)]
    for index in range(PLY_ROWS * PLY_COLUMNS):
        row, column = divmod(index, PLY_COLUMNS)
        local = index % 64
        tile = sheet[row * TILE:(row + 1) * TILE, column * TILE:(column + 1) * TILE]
        y, x = (local >> 3) * TILE, (local & 7) * TILE
        pages[index // 64][y:y + TILE, x:x + TILE] = tile
    return pages


def rgba(rgb: np.ndarray) -> np.ndarray:
    alpha = np.where(is_key(rgb), 0, 255).astype(np.uint8)
    return np.dstack([rgb, alpha])


def stock_pages(data: Path) -> Iterator[tuple[str, np.ndarray]]:
    """Yields each replaceable page as its name relative to the data folder and its RGB texels."""
    for path in sorted(data.rglob("*")):
        if not path.is_file() or path.parts[len(data.parts)] == "HD":
            continue
        relative = path.relative_to(data)
        suffix = path.suffix.upper()
        if suffix == ".RAW" and path.stat().st_size == PAGE_BYTES:
            yield relative.with_suffix("").as_posix(), np.frombuffer(path.read_bytes(), np.uint8).reshape(PAGE, PAGE, 3)
        elif suffix == ".PLY" and path.stat().st_size == PLY_COLUMNS * PLY_ROWS * TILE * TILE * 3:
            for part, page in enumerate(playfield_pages(path.read_bytes())):
                yield f"{relative.as_posix()}.{part}", page


def _dump(args: argparse.Namespace) -> None:
    count = 0
    for name, page in stock_pages(args.data):
        output = args.out / f"{name}.png"
        output.parent.mkdir(parents=True, exist_ok=True)
        Image.fromarray(rgba(page)).save(output)
        count += 1
    print(f"{count} pages in {args.out}")


def fill_transparent(page: np.ndarray) -> np.ndarray:
    """Gives every transparent texel the colour of nearby opaque ones, so filtering and mipmaps never reach the key green."""
    opaque = page[..., 3] > 0
    if opaque.all() or not opaque.any():
        return page
    side = page.shape[0]
    weights = opaque.astype(np.float64)
    colour = page[..., :3].astype(np.float64) * weights[..., None]
    levels = [(colour, weights)]
    while side > 1:
        colour = colour.reshape(side // 2, 2, side // 2, 2, 3).sum(axis=(1, 3))
        weights = weights.reshape(side // 2, 2, side // 2, 2).sum(axis=(1, 3))
        side //= 2
        levels.append((colour, weights))
    filled = levels[-1][0] / np.maximum(levels[-1][1], 1e-9)[..., None]
    for colour, weights in reversed(levels[:-1]):
        filled = filled.repeat(2, axis=0).repeat(2, axis=1)
        known = weights > 0
        filled[known] = colour[known] / weights[known][..., None]
    result = page.copy()
    result[~opaque, :3] = np.clip(np.rint(filled[~opaque]), 0, 255).astype(np.uint8)
    return result


def _pack(args: argparse.Namespace) -> None:
    out = args.out or args.data / "HD" / args.name
    stock = dict(stock_pages(args.data))
    failed = False
    count = 0
    for path in sorted(args.source.rglob("*.png")):
        name = path.relative_to(args.source).with_suffix("").as_posix()
        if name not in stock:
            print(f"{name}: no stock page with this name")
            failed = True
            continue
        try:
            page = pack_page(np.asarray(Image.open(path).convert("RGBA")), stock[name])
        except ValueError as error:
            print(f"{name}: {error}")
            failed = True
            continue
        output = out / f"{name}.RGBA"
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_bytes(page.tobytes())
        count += 1
    print(f"{count} pages in {out}")
    raise SystemExit(1 if failed else 0)


def _resize(args: argparse.Namespace) -> None:
    count = 0
    for name, page in stock_pages(args.data):
        if args.only and not any(name.startswith(prefix) for prefix in args.only):
            continue
        image = rgba(page).repeat(args.scale, 0).repeat(args.scale, 1)
        if args.invert:
            image[..., :3] = 255 - image[..., :3]
        output = args.out / f"{name}.png"
        output.parent.mkdir(parents=True, exist_ok=True)
        Image.fromarray(image).save(output)
        count += 1
    print(f"{count} pages in {args.out}")


if __name__ == "__main__":
    main()
