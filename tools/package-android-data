#!/usr/bin/env python3
from pathlib import Path
import zipfile


root = Path(__file__).resolve().parent.parent
data = root / "gamedata"
output = root / "android/build/sonic-r-data.zip"
folders = ["AI", "BIN", "CITY", "EMERALD", "FACTORY", "GENERAL", "ISLAND", "RUIN", "SOUND", "MUSIC"]
for name in folders:
    if not (data / name).is_dir():
        raise SystemExit(f"Missing game data folder: {data / name}")
output.parent.mkdir(parents=True, exist_ok=True)
with zipfile.ZipFile(output, "w", compression=zipfile.ZIP_DEFLATED) as archive:
    for name in folders + (["HD"] if (data / "HD").is_dir() else []):
        for file in sorted((data / name).rglob("*")):
            if file.is_file():
                archive.write(file, file.relative_to(data).as_posix())
print(output)
